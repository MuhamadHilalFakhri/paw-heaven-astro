---
import type { LocaleProps } from "../i18n/config";
import { getMessages } from "../i18n/messages";
import trustCatImage from "../assets/clear/trust-cats-playing.webp";
interface Props extends LocaleProps {}
const { locale } = Astro.props;
const { page: t } = getMessages(locale);

---

<section class="testimonial-band" aria-labelledby="trust-title">
  <span class="trust-leaf" aria-hidden="true">✿</span>
  <h2 id="trust-title">{t.trustTitle[0]}<br />{t.trustTitle[1]}</h2>
  <p>{t.trustText}</p>
  <img
    src={trustCatImage.src}
    width={trustCatImage.width}
    height={trustCatImage.height}
    alt={t.trustAlt}
    loading="lazy"
    decoding="async"
  />
  <span class="trust-star" aria-hidden="true">✧</span>
</section>

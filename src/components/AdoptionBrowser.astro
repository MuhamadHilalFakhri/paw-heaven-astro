---
import { adoptablePets } from "../data/community-content";
import AdoptionProfiles from "./interactive/AdoptionProfiles";
const pets = adoptablePets.filter(pet => pet.status !== 'Adopted');
---

<section id="adoptable-pets" class="community-section adoption-browser" aria-labelledby="adoption-browser-title">
  <div class="section-heading">
    <p class="eyebrow">A companion, a new beginning</p>
    <h2 id="adoption-browser-title">Find your next companion</h2>
    <p>Explore a match for your home and ask our team about current availability.</p>
  </div>
  <AdoptionProfiles pets={pets} client:load />
</section>

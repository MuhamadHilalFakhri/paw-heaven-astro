---
import type { LocaleProps } from "../i18n/config";
import { getMessages } from "../i18n/messages";
import { adoptablePets } from "../data/community-content";
import AdoptionProfiles from "./interactive/AdoptionProfiles";
import miloArt from "../assets/clear/adoption-milo.webp";
import mimiArt from "../assets/clear/adoption-mimi.webp";
import boluArt from "../assets/clear/adoption-bolu.webp";
import cocoArt from "../assets/clear/adoption-coco.webp";
const pets = adoptablePets.filter(pet => pet.status !== 'Adopted');
interface Props extends LocaleProps {}
const { locale } = Astro.props;
const { page: t } = getMessages(locale);

---

<section id="adoptable-pets" class="community-section adoption-browser" aria-labelledby="adoption-browser-title">
  <div class="section-heading">
    <p class="eyebrow">{t.adoptionEyebrow}</p>
    <h2 id="adoption-browser-title">{t.adoptionBrowserTitle}</h2>
    <p>{t.adoptionBrowserText}</p>
  </div>
  <AdoptionProfiles locale={locale} pets={pets} showcaseImages={{ Milo: miloArt.src, Mimi: mimiArt.src, Bolu: boluArt.src, Coco: cocoArt.src }} client:load />
</section>

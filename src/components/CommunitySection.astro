---
import { clinicPhotos, clientReviews } from "../data/community-content";
import RequestForm from "./interactive/RequestForm";
import ReviewCarousel from "./interactive/ReviewCarousel";
import ActionLink from "./interactive/ActionLink";
import { Card } from "./ui/card";
import { Button } from "./ui/button";
const reviews = clientReviews.filter(review => review.permissionConfirmed);
---

<section id="community" class="community-section" aria-labelledby="community-title">
  <div class="section-heading">
    <p class="eyebrow">Feel at home before you visit</p>
    <h2 id="community-title">Your visit, your story</h2>
    <p>Get in touch before your first visit, or tell us about the care your companion received.</p>
  </div>
  <div class="community-grid">
    <Card className="community-card">
      <h3>Plan your first visit</h3>
      <p>9235 Bayberry Drive<br />Hendersonville, NC 28792</p>
      <p>Ask about the care setting, what to bring, and arrangements that could help your pet feel comfortable.</p>
      {clinicPhotos.length > 0 && (
        <div class="clinic-gallery">
          {clinicPhotos.map(photo => (
            <Button type="button" className="gallery-thumb" data-gallery-src={photo.src} data-gallery-alt={photo.alt} aria-label={`View photo: ${photo.alt}`} aria-haspopup="dialog">
              <img src={photo.src} width={photo.width} height={photo.height} alt={photo.alt} loading="lazy" decoding="async" />
            </Button>
          ))}
        </div>
      )}
      <ActionLink href="#contact" data-booking data-booking-context="First visit enquiry">Plan a visit</ActionLink>
    </Card>
    <Card className="community-card">
      <h3>Pet parent stories</h3>
      {reviews.length > 0 ? (
        <ReviewCarousel reviews={reviews} client:load />
      ) : <p>Every companion has a story. Tell us about your visit and what made a difference for your pet.</p>}
      <RequestForm kind="feedback" client:load />
    </Card>
  </div>
</section>

---
import type { LocaleProps } from "../i18n/config";
import { getMessages } from "../i18n/messages";
import clubImage from "../assets/clear/plan-club-grooming.webp";
import starterImage from "../assets/clear/plan-starter.webp";
import wellnessImage from "../assets/clear/plan-wellness-checkup.webp";
import type { ImageMetadata } from "astro";
import { getSiteContent } from "../data/site-content";
import PlanFinder from "./interactive/PlanFinder";
import ActionLink from "./interactive/ActionLink";
import { Card } from "./ui/card";
import { Badge } from "./ui/badge";
import { formatPrice } from "../i18n/config";

const planImages: Record<string, ImageMetadata> = {
  starter: starterImage,
  wellness: wellnessImage,
  club: clubImage,
};
interface Props extends LocaleProps {}
const { locale } = Astro.props;
const { page: t } = getMessages(locale);
const { plans } = getSiteContent(locale);

---

<section id="plans" class="plans-section">
  <div class="section-heading">
    <h2>{t.plansTitle}</h2>
    <p>
      {t.plansText[0]}<br class="desktop-break" />
      {t.plansText[1]}
    </p>
  </div>
  <PlanFinder locale={locale} client:load />
  <div class="plan-grid">
    {plans.map((plan) => {
      const image = planImages[plan.image];
      return (
        <Card className={`plan-card ${plan.color}`} data-plan={plan.image}>
          <Badge className="recommended-badge" data-plan-badge hidden>{t.recommended}</Badge>
          <Badge className="demo-badge">{t.demoLabel}</Badge>
          <h3>{plan.name}</h3>
          <p class="plan-description">{plan.text}</p>
          <img src={image.src} width={image.width} height={image.height} alt="" loading="lazy" decoding="async" />
          <div class="plan-price">
            <strong>{formatPrice(plan.price, locale)}</strong>
            <span>{t.monthly}</span>
          </div>
          <ActionLink href="#contact" data-booking data-booking-service="preventive" data-booking-plan={plan.name}>{t.askPlan}</ActionLink>
          <div class="plan-benefits">
            <h4>{plan.label}</h4>
            <ul class="check-list">
              {plan.features.map((text) => (
                <li><span class="check-icon" aria-hidden="true">✓</span><span>{text}</span></li>
              ))}
            </ul>
          </div>
        </Card>
      );
    })}
  </div>
</section>

---
import type { LocaleProps } from "../i18n/config";
import { getMessages } from "../i18n/messages";
import groomingImage from "../assets/clear/grooming.webp";
import homeVisitImage from "../assets/clear/home-visit.webp";
import introDogImage from "../assets/clear/intro-dog.webp";
import introFishImage from "../assets/clear/intro-fish.webp";
import introVetImage from "../assets/clear/intro-vet.webp";
import vetImage from "../assets/clear/vet.webp";
import type { ImageMetadata } from "astro";
import { getSiteContent } from "../data/site-content";
import { Card } from "./ui/card";
import { Badge } from "./ui/badge";
import { getIntroContent } from "../i18n/intro-content";

const featureImages: Record<string, ImageMetadata> = {
  grooming: groomingImage,
  homeVisit: homeVisitImage,
  vet: vetImage,
};
interface Props extends LocaleProps {}
const { locale } = Astro.props;
const { page: t } = getMessages(locale);
const { features } = getSiteContent(locale);
const intro = getIntroContent(locale);

---

<section id="about" class="intro-section" aria-labelledby="intro-title">
  <div class="intro-overview">
    <p class="eyebrow">{t.aboutLabel}</p>
    <h2 id="intro-title" class="intro-heading">{intro.title}</h2>
    <p class="intro-description">{intro.description}</p>
    <ul class="intro-benefits">{intro.benefits.map((benefit, index) => <li><Badge variant="secondary"><span aria-hidden="true">{["🐾", "♡", "⌂"][index]}</span>{benefit}</Badge></li>)}</ul>
    <div class="intro-decorations" aria-hidden="true">{[introVetImage, introFishImage, introDogImage].map(image => <img src={image.src} width={image.width} height={image.height} alt="" loading="lazy" />)}</div>
  </div>
  <div class="feature-grid">
    {features.map((item) => {
      const image = featureImages[item.image];
      return (
        <Card className={`feature-card ${item.color}`}>
          <img src={image.src} width={image.width} height={image.height} alt="" loading="lazy" decoding="async" />
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </Card>
      );
    })}
  </div>
</section>

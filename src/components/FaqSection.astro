---
import type { LocaleProps } from "../i18n/config";
import { getMessages } from "../i18n/messages";
import faqDogImage from "../assets/clear/faq-dog.webp";
import faqImage from "../assets/clear/faq-transparent.webp";
import FaqAccordion from "./interactive/FaqAccordion";
interface Props extends LocaleProps {}
const { locale } = Astro.props;
const { page: t } = getMessages(locale);

---

<section id="faq" class="faq-section">
  <div>
    <h2>{t.faqTitle[0]}<br />{t.faqTitle[1]} <span aria-hidden="true">✧</span></h2>
    <img
      class="faq-illustration"
      src={faqImage.src}
      width={faqImage.width}
      height={faqImage.height}
      alt={t.faqAlt}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="faq-questions">
    <img
      class="faq-dog"
      src={faqDogImage.src}
      width={faqDogImage.width}
      height={faqDogImage.height}
      alt=""
      loading="lazy"
      decoding="async"
    />
    <FaqAccordion locale={locale} client:visible={{ rootMargin: "240px" }} />
  </div>
</section>

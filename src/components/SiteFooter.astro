---
import type { LocaleProps } from "../i18n/config";
import { getMessages } from "../i18n/messages";
import footerImage from "../assets/clear/footer.webp";
import { getSiteContent } from "../data/site-content";
import RequestForm from "./interactive/RequestForm";
interface Props extends LocaleProps {}
const { locale } = Astro.props;
const { page: t } = getMessages(locale);
const { navigationLinks } = getSiteContent(locale);

---

<footer id="contact" class="paw-footer">
  <img
    class="footer-illustration"
    src={footerImage.src}
    width={footerImage.width}
    height={footerImage.height}
    alt={t.footerAlt}
    loading="lazy"
    decoding="async"
  />
  <div class="footer-grid">
    <div>
      <h3>{t.newsletter}</h3>
      <p>{t.newsletterText}</p>
      <RequestForm locale={locale} kind="newsletter" client:load />
    </div>
    <div>
      <h3>{t.contact}</h3>
      <a href="mailto:Pawheaven@gmail.com">Pawheaven@gmail.com</a>
      <a href="tel:+861815785051">+86 181 578 5051</a>
      <h4>{t.address}</h4>
      <p>9235 Bayberry Drive<br />Hendersonville, NC 28792</p>
    </div>
    <div>
      <h3>{t.quickLinks}</h3>
      {navigationLinks.map(({ label, href }) => <a href={href}>{label}</a>)}
    </div>
    <div>
      <h3>{t.policies}</h3>
      <p>{t.policyText}</p>
      <a href={`mailto:Pawheaven@gmail.com?subject=${encodeURIComponent(t.policySubject)}`}>{t.askPolicies}</a>
    </div>
  </div>
  <div class="footer-bottom">
    <p>©2026 PawCare+. {t.copyright}</p>
  </div>
</footer>

---
import type { LocaleProps } from "../i18n/config";
import { getMessages } from "../i18n/messages";
import ActionLink from "./interactive/ActionLink";
interface Props extends LocaleProps {}
const { locale } = Astro.props;
const { page: t } = getMessages(locale);

---
<div class="mobile-booking-bar">
  <ActionLink href="#contact" className="paw-button secondary-action">{t.call}</ActionLink>
  <ActionLink href="#contact" data-booking>{t.bookVisit}</ActionLink>
</div>

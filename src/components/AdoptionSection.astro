---
import type { LocaleProps } from "../i18n/config";
import { getMessages } from "../i18n/messages";
import adoptionImage from "../assets/clear/adoption-three-cats.webp";
import { getSiteContent } from "../data/site-content";
import ActionLink from "./interactive/ActionLink";
interface Props extends LocaleProps {}
const { locale } = Astro.props;
const { page: t } = getMessages(locale);
const { adoptionReasons } = getSiteContent(locale);

---

<section id="about" class="adoption-section">
  <img
    src={adoptionImage.src}
    width={adoptionImage.width}
    height={adoptionImage.height}
    alt={t.adoptionAlt}
    loading="lazy"
    decoding="async"
  />
  <div>
    <h2>{t.adoptionTitle[0]}<br />{t.adoptionTitle[1]}</h2>
    <p>
      {t.adoptionText}
    </p>
    <h3>{t.adoptionWhy}</h3>
    <ul class="check-list">
      {adoptionReasons.map((text) => (
        <li><span class="check-icon" aria-hidden="true">✓</span><span>{text}</span></li>
      ))}
    </ul>
    <div class="adoption-actions">
      <ActionLink href="#contact" data-booking data-booking-service="adoption">{t.book}</ActionLink>
      <ActionLink href="#adoptable-pets" className="paw-button secondary-action">
        {t.askAdoption}
      </ActionLink>
    </div>
  </div>
</section>
